# Resque.AI Environment Configuration

# App
APP_NAME=Resque.AI
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resque
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL_SECONDS=300

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_EVENTS=raw.events
KAFKA_TOPIC_NORMALIZED_EVENTS=normalized.events
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP=resque-ingestion

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATA=raw-data
MINIO_SECURE=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=resque-hazard-prediction

# External APIs - Get keys from respective providers
# USGS: No key required
USGS_BASE_URL=https://earthquake.usgs.gov
USGS_RATE_LIMIT=60

# NOAA: No key required
NOAA_BASE_URL=https://api.weather.gov
NOAA_RATE_LIMIT=100

# FEMA: Register at https://www.fema.gov/about/openfema
FEMA_BASE_URL=https://www.fema.gov/api/open
FEMA_RATE_LIMIT=60

# OpenWeather: Get key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_RATE_LIMIT=60

# WeatherAPI: Get key at https://www.weatherapi.com/
WEATHERAPI_KEY=your_weatherapi_key
WEATHERAPI_BASE_URL=http://api.weatherapi.com/v1
WEATHERAPI_RATE_LIMIT=60

# NASA FIRMS: Get key at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_KEY=your_nasa_firms_key
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# Ingestion
INGESTION_INTERVAL_MINUTES=5
HISTORICAL_INGESTION_DAYS_BACK=365
BATCH_SIZE=1000

# ML Models
MODEL_CACHE_TTL_SECONDS=3600
PREDICTION_GRID_RESOLUTION_DEG=0.1
EARTHQUAKE_MODEL_VERSION=eq_v1.0
FLOOD_MODEL_VERSION=flood_v1.0
HURRICANE_MODEL_VERSION=hurricane_v1.0

# Alert Thresholds
EQ_WATCH_PROBABILITY=0.15
EQ_WARNING_PROBABILITY=0.30
FLOOD_WATCH_PROBABILITY=0.40
FLOOD_WARNING_PROBABILITY=0.70
HURRICANE_WATCH_DAYS=5
HURRICANE_WARNING_DAYS=2

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Monitoring
PROMETHEUS_METRICS_PATH=/metrics
LOG_LEVEL=INFO
LOG_FORMAT=json

# Map
MAPBOX_TOKEN=your_mapbox_token
DEFAULT_MAP_CENTER_LAT=39.8283
DEFAULT_MAP_CENTER_LON=-98.5795
DEFAULT_MAP_ZOOM=4

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id